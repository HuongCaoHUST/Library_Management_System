<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #1f3368;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.project.javafxcontroller.BorrowSlipConfirmController">

    <children>

        <!-- Title -->
        <Label layoutX="30.0" layoutY="20.0" text="XÁC NHẬN PHIẾU MƯỢN" textFill="WHITE">
            <font>
                <Font name="Segoe UI Bold" size="24.0" />
            </font>
        </Label>

        <!-- Table -->
        <TableView fx:id="confirmTableView" layoutX="30.0" layoutY="80.0" prefHeight="380.0" prefWidth="840.0" styleClass="borrow-slip-confirm-table" stylesheets="@fpackstyling2.css" AnchorPane.rightAnchor="30.0">

            <columns>
                <TableColumn fx:id="colIndex" prefWidth="59.20001411437988" text="STT" />
                <TableColumn fx:id="colDocumentId" prefWidth="103.99995422363281" text="Mã tài liệu" />
                <TableColumn fx:id="colTitle" prefWidth="380.0001220703125" text="Tên tài liệu" />
                <TableColumn fx:id="colAuthor" prefWidth="185.5999755859375" text="Tác giả" />
                <TableColumn fx:id="colQuantity" prefWidth="89.60009765625" text="Số lượng" />
            </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>

        </TableView>

        <!-- Action buttons -->
        <HBox layoutX="30.0" layoutY="490.0" spacing="20.0" AnchorPane.rightAnchor="30.0">

            <Button fx:id="btnCancel" onAction="#handleCancel" prefHeight="45" prefWidth="140" styleClass="rdl-button" stylesheets="@fpackstyling2.css" text="HỦY">
            </Button>

            <Button fx:id="btnConfirm" onAction="#handleConfirmBorrow" prefHeight="45" prefWidth="190" styleClass="borrow-slip-confirm-approve-btn" stylesheets="@fpackstyling2.css" text="XÁC NHẬN MƯỢN">
            </Button>

        </HBox>

    </children>
</AnchorPane>
