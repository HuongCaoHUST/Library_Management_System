<VBox alignment="TOP_CENTER" prefWidth="621.0" spacing="20.0" styleClass="borrow-slip-detail-container" stylesheets="@fpackstyling2.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.project.javafxcontroller.BorrowSlipDetailController">
